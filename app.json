{
  "expo": {
    "name": "digital-desk",
    "slug": "digital-desk",
    "version": "1.0.0",
    "scheme": "digitaldesk",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5577E8",
          "defaultChannel": "default"
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
